{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Meow KnowledgePack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packId",
    "source",
    "bookMatch",
    "sections"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "packId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "toolVersion"
      ],
      "properties": {
        "type": {
          "enum": [
            "book-to-skill",
            "manual",
            "local-notes"
          ]
        },
        "toolVersion": {
          "type": "string",
          "maxLength": 100
        },
        "generatedAtUtc": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "bookMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 400
        },
        "author": {
          "type": "string",
          "maxLength": 200
        },
        "fingerprint": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sectionId",
          "chapterOrder",
          "title",
          "content",
          "contentSha256"
        ],
        "properties": {
          "sectionId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$",
            "maxLength": 120
          },
          "chapterOrder": {
            "type": "integer",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "maxLength": 300
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "sourceLocator": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 300
          },
          "contentSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
